# SBOM vulnerability scanner — minimal, dedicated image.
# Runs grype against stored SBOMs (produced by syft via the image-scanner
# and create-run pipelines) and uploads findings to the worker API. Grype
# is the single scanner today; trivy was removed once the server-side
# ingest learned to dispatch on root-shape of the JSON payload.
#
# The grype DB is downloaded at container startup so the image stays
# small and always uses a fresh database. Egress is restricted via
# NetworkPolicy to public HTTPS (for DB download) + the worker API only.
# All private/internal ranges (RFC 1918) are blocked.

# Build the sbom-scanner Go binary
FROM golang:1.26-alpine AS builder

WORKDIR /build
COPY go.mod go.sum* ./
RUN go mod download

COPY cmd/sbom-scanner/ ./cmd/sbom-scanner/
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o sbom-scanner ./cmd/sbom-scanner/main.go

# Grype — same Anchore toolchain as syft (which generates our SBOMs), so
# we feed its output directly without any format translation.
FROM anchore/grype:latest AS grype

# Runtime stage — minimal
FROM alpine:3.20

RUN apk add --no-cache ca-certificates

COPY --from=grype /grype /usr/local/bin/grype
COPY --from=builder /build/sbom-scanner /usr/local/bin/sbom-scanner

RUN mkdir -p /home/scanner /grype-cache /tmp && \
    adduser -D -u 1000 scanner && \
    chown -R 1000:1000 /home/scanner /grype-cache

USER 1000:1000
ENV HOME=/home/scanner
ENTRYPOINT ["/usr/local/bin/sbom-scanner"]
