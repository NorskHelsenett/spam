# spam-image-scanner — dedicated pod that leases IMAGE_SCAN jobs and runs
# a pluggable scanner pipeline (grype/syft/cosign/crane/betterleaks; trivy
# opt-in) against each image digest.
#
# Mirrors the trivy-scanner pattern: init container warms the vuln DB once,
# the main binary drains the queue, then the pod exits. Fresh DB every
# CronJob tick; DB is never stored in a PVC.
#
# Egress expectations (set via NetworkPolicy in the helm chart):
#   - HTTPS to public registries hosting the scanned images
#   - HTTPS to the configured vuln DB source (ghcr.io for grype, or an
#     in-cluster mirror if GRYPE_DB_UPDATE_URL is set)
#   - HTTP to the worker service for lease/upload/complete
#   - No other egress allowed

# Build the Go image-scanner binary
FROM golang:1.26-alpine AS builder

WORKDIR /build
COPY go.mod go.sum* ./
RUN go mod download

COPY cmd/image-scanner/ ./cmd/image-scanner/
COPY imagescan/ ./imagescan/
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" \
    -o image-scanner ./cmd/image-scanner/

# Scanner binaries — upstream images, pinned where digests are available.
# Version tags should be SHA-pinned before promoting past staging; left
# floating here so operators can verify against their internal mirror first.
FROM ghcr.io/anchore/syft:v1.42.3@sha256:5999d209a342e55e9edf70bf8930fb5b86d8f2a783fa401178372c50e21b1d36 AS syft
FROM anchore/grype:v0.100.0 AS grype
FROM gcr.io/go-containerregistry/crane:v0.20.7 AS crane
FROM gcr.io/projectsigstore/cosign:v2.6.2 AS cosign
FROM ghcr.io/betterleaks/betterleaks:v1.1.1@sha256:8c1fdaaeef493bb27dda66051a2bf7874e5c6feeb5fe8eced1359afdbf8c2571 AS betterleaks
# Trivy is opt-in per category (payload.scanners) — shipping the binary
# keeps the opt-in one env flag away rather than a separate image.
FROM aquasec/trivy:0.69.3@sha256:bcc376de8d77cfe086a917230e818dc9f8528e3c852f7b1aff648949b6258d1c AS trivy

# Runtime — alpine with GNU tar (busybox tar chokes on some OCI layer
# formats) and ca-certificates for TLS to registries + DB sources.
FROM alpine:3.20

RUN apk add --no-cache ca-certificates tar

COPY --from=syft        /syft                      /usr/local/bin/syft
COPY --from=grype       /grype                     /usr/local/bin/grype
COPY --from=crane       /ko-app/crane              /usr/local/bin/crane
COPY --from=cosign      /ko-app/cosign             /usr/local/bin/cosign
COPY --from=betterleaks /usr/bin/betterleaks       /usr/local/bin/betterleaks
COPY --from=trivy       /usr/local/bin/trivy       /usr/local/bin/trivy
COPY --from=builder     /build/image-scanner       /usr/local/bin/image-scanner

# Non-root user, writable scratch volumes provided by the pod spec.
RUN mkdir -p /home/scanner /work /grype-cache /trivy-cache && \
    adduser -D -u 1000 scanner && \
    chown -R 1000:1000 /home/scanner /work /grype-cache /trivy-cache

USER 1000:1000
ENV HOME=/home/scanner \
    WORK_DIR=/work \
    GRYPE_DB_CACHE_DIR=/grype-cache \
    TRIVY_CACHE_DIR=/trivy-cache

ENTRYPOINT ["/usr/local/bin/image-scanner"]
