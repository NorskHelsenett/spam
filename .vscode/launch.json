{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch Package",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/api/cmd/server/main.go",
            "env": {
                "PGHOST": "localhost",
                "PGPORT": "5432",
                "PGUSER": "postgres",
                "PGPASSWORD": "",
                "PGDATABASE": "postgres",
                "PGSSLMODE": "disable",
                "OIDC_CLIENT_ID": "spam-local-client",
                "OIDC_CLIENT_SECRET": "spam-local-secret",
                "OIDC_REDIRECT_URI": "http://localhost:5178/api/callback",
                "OIDC_PROVIDER_URI": "http://host.containers.internal:9999"
            },
        }
    ]
}